# Copia este archivo como .env y completa los valores de tu entorno.
# El archivo .env NUNCA se sube a GitHub.

APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=America/La_Paz
API_PREFIX=/api

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cancha_satelite
# Usuario de MySQL exclusivo del proyecto (ver README: "Base de datos")
DB_USERNAME=cancha_app
DB_PASSWORD=

# URL pública del sitio (se usa en los enlaces de los correos)
APP_URL=http://cancha-satelite.test

# Correo. Local: Mailpit de Laragon (127.0.0.1:1025). Producción: SMTP del hosting
# o Gmail (smtp.gmail.com, 587, tls, con contraseña de aplicación).
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_ENCRYPTION=none
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-responder@cancha-satelite.test
MAIL_FROM_NAME="Cancha Satélite Norte"
